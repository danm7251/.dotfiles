configuration {
    modi: "run";
    show-icons: true;
    drun-display-format: "{name}";

    matching: "normal";
    tokenize: true;
    levenshtein-sort: false;

    disable-history: false;
    sort: true;
    sorting-method: "fzf";
    max-history-size: 15;
}

@theme "/dev/null"
@import "colors.rasi"

* {
    font: "JetBrains Mono Nerd Font 11";
}

window {
    width: 650px;
    height: 400px;
    border: 2px solid;
    border-color: @border-col;
    border-radius: 20px;
    background-color: @bg-col;
    padding: 20px;
}

mainbox {
    background-color: @bg-col;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 10px 16px;
    margin: 0px 0px 20px 0px;
    children: [ entry ];
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @fg-col-dim;
    text-color: @fg-col;
    background-color: transparent;
}

listview {
    background-color: transparent;
    columns: 2;
    lines: 6;
    spacing: 8px;
    cycle: false;
    dynamic: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @fg-col;
    orientation: horizontal;
    border-radius: 6px;
    padding: 8px 12px;
    spacing: 12px;
}

element-icon {
    background-color: transparent;
    size: 32px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element selected {
    background-color: @accent-col;
    text-color: @bg-col; /* Dynamically uses your dark background color for contrast */
}